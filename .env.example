# ==========================================
# AI VOICE CALLING & BROADCAST PLATFORM CONFIG
# ==========================================

# Server Environment
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
APP_URL=https://app.yourdomain.com

# Database (PostgreSQL)
DATABASE_URL="postgresql://voice_user:voice_secure_pass_123@postgres:5432/voice_db?schema=public"

# Redis & BullMQ
REDIS_URL="redis://redis:6379"

# OpenAI Realtime Voice Configuration
OPENAI_API_KEY="sk-proj-your-openai-realtime-api-key"
OPENAI_REALTIME_MODEL="gpt-4o-realtime-preview"

# Telephony: Exotel Credentials (Primary for India)
EXOTEL_API_KEY="your_exotel_api_key"
EXOTEL_API_TOKEN="your_exotel_api_token"
EXOTEL_ACCOUNT_SID="your_exotel_account_sid"
EXOTEL_CALLER_ID="080XXXXXXXX"
EXOTEL_BASE_URL="https://api.exotel.com"
EXOTEL_STREAM_URL="wss://voice.yourdomain.com/exotel/media"

# Webhook Base URL (Public URL where Exotel sends callbacks)
PUBLIC_WEBHOOK_BASE_URL="https://api.yourdomain.com"

# Outgoing CRM Webhook (Deal CRM / WhatsApp CRM)
CRM_WEBHOOK_URL="https://crm.yourdomain.com/api/v1/voice/callback"
CRM_WEBHOOK_SECRET="whsec_ai_voice_crm_hmac_secret_key_9988"

# Ingoing Webhook Authentication Secret (For Website Leads)
INCOMING_WEBHOOK_SECRET="whsec_website_leads_incoming_secret_1234"

# Telephony Queue Concurrency & Execution Limits
CALL_CONCURRENCY=5
DEFAULT_MAX_CALL_DURATION=300

# Razorpay Payment Gateway (Indian Cards, UPI, NetBanking)
RAZORPAY_KEY_ID="rzp_live_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Security & Encryption
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
JWT_SECRET="super-secret-jwt-signing-key-for-voice-calling-platform-2026"
ADMIN_DEFAULT_PASSWORD="ChangeMeInProduction123!"
